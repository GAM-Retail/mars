// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  String               @id @default(uuid())
  nik                 String               @unique
  password            String
  email               String               @unique
  name                String
  role                UserRole
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  ext                 String?              @default("-")
  divisionId          String?              @map("division_id")
  division            Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  departmentId        String?              @map("department_id")
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facilities          Facility[]
  rooms               Room[]
  roomPersonInCharges RoomPersonInCharge[]
  roomReservations    RoomReservation[]

  @@map("tm_users")
}

enum UserRole {
  SUPERADMIN
  ADMIN
}

model Facility {
  id             String         @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdByUser  User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      String?        @map("created_by")
  roomFacilities RoomFacility[]

  @@map("tm_facilities")
}

model Room {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  location            String
  capacity            Int
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdByUser       User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy           String?              @map("created_by")
  roomFacilities      RoomFacility[]
  roomPersonInCharges RoomPersonInCharge[]
  roomReservations    RoomReservation[]

  @@map("tm_rooms")
}

model RoomFacility {
  id         String   @id @default(uuid())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String   @map("room_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String   @map("facility_id")

  @@map("tm_room_facilities")
}

model RoomPersonInCharge {
  id               String @id @default(uuid())
  room             Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId           String @map("room_id")
  personInCharge   User   @relation(fields: [personInChargeId], references: [id], onDelete: Cascade)
  personInChargeId String @map("person_in_charge_id")

  @@map("tm_room_person_in_charges")
}

model Organizer {
  id               String            @id @default(uuid())
  nik              String
  name             String
  email            String            @unique
  phone            String
  departmentId     String?           @map("department_id")
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  divisionId       String?           @map("division_id")
  division         Division?         @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  roomReservations RoomReservation[]

  @@map("tx_organizers")
}

model RoomReservation {
  id           String    @id @default(uuid())
  room         Room      @relation(fields: [roomId], references: [id], onDelete: NoAction)
  roomId       String    @map("room_id")
  reservedBy   User      @relation(fields: [reservedById], references: [id], onDelete: NoAction)
  reservedById String    @map("reserved_by_id")
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: NoAction)
  organizerId  String    @map("organizer_id")
  startTime    DateTime  @map("start_time")
  endTime      DateTime  @map("end_time")
  agenda       String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("tx_room_reservations")
}

enum ReservationAction {
  CREATE
  UPDATE
  DELETE
}

model RoomReservationLog {
  id                              String                           @id @default(uuid())
  reservationId                   String                           @map("reservation_id")
  action                          ReservationAction
  performedBy                     String                           @map("performed_by")
  performedByName                 String?                          @map("performed_by_name")
  changes                         Json?
  createdAt                       DateTime                         @default(now()) @map("created_at")
  roomReservationNotificationLogs RoomReservationNotificationLog[]

  @@map("tx_room_reservation_logs")
}

enum NotificationStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model RoomReservationNotificationLog {
  id               String              @id @default(uuid())
  reservationId    String              @map("reservation_id")
  reservationLogId String?
  reservationLog   RoomReservationLog? @relation(fields: [reservationLogId], references: [id], onDelete: SetNull)
  phone            String
  status           NotificationStatus
  error            String?
  message          String?
  sentAt           DateTime            @default(now()) @map("sent_at")

  @@map("tx_room_reservation_notification_logs")
}

model Division {
  id            String          @id @default(uuid())
  name          String
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  organizations Organizations[]
  users         User[]
  organizers    Organizer[]

  @@map("tm_divisions")
}

model Department {
  id            String          @id @default(uuid())
  name          String
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  organizations Organizations[]
  users         User[]
  organizers    Organizer[]

  @@map("tm_departments")
}

model Organizations {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  divisionId   String     @map("division_id")
  division     Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("tm_organizations")
}