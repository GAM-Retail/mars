// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String @id @default(uuid())
  nik      String @unique
  password String
  email    String @unique
  name     String

  @@map("tm_users")
}
