// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  String               @id @default(uuid())
  nik                 String               @unique
  password            String
  email               String               @unique
  name                String
  role                UserRole
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  ext                 String?              @default("-")
  division            String?              @default("-")
  department          String?              @default("-")
  facilities          Facility[]
  rooms               Room[]
  roomPersonInCharges RoomPersonInCharge[]
  roomReservations    RoomReservation[]

  @@map("tm_users")
}

enum UserRole {
  SUPERADMIN
  ADMIN
}

model Facility {
  id             String         @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdByUser  User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      String?        @map("created_by")
  roomFacilities RoomFacility[]

  @@map("tm_facilities")
}

model Room {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  location            String
  capacity            Int
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdByUser       User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy           String?              @map("created_by")
  roomFacilities      RoomFacility[]
  roomPersonInCharges RoomPersonInCharge[]
  roomReservations    RoomReservation[]

  @@map("tm_rooms")
}

model RoomFacility {
  id         String   @id @default(uuid())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String   @map("room_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String   @map("facility_id")

  @@map("tm_room_facilities")
}

model RoomPersonInCharge {
  id               String @id @default(uuid())
  room             Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId           String @map("room_id")
  personInCharge   User   @relation(fields: [personInChargeId], references: [id], onDelete: Cascade)
  personInChargeId String @map("person_in_charge_id")

  @@map("tm_room_person_in_charges")
}

model Organizer {
  id               String            @id @default(uuid())
  nik              String
  name             String
  email            String            @unique
  phone            String
  department       String?
  division         String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  roomReservations RoomReservation[]

  @@map("tx_organizers")
}

model RoomReservation {
  id           String    @id @default(uuid())
  room         Room      @relation(fields: [roomId], references: [id], onDelete: NoAction)
  roomId       String    @map("room_id")
  reservedBy   User      @relation(fields: [reservedById], references: [id], onDelete: NoAction)
  reservedById String    @map("reserved_by_id")
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: NoAction)
  organizerId  String    @map("organizer_id")
  startTime    DateTime  @map("start_time")
  endTime      DateTime  @map("end_time")
  agenda       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("tx_room_reservations")
}
